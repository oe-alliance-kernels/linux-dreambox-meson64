				reg = <0x00 0x1f000 0x00 0x20>;
				interrupts = <0x00 0x15 0x01 0x00 0x5b 0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x02 0x2b>;
				clock-names = "clk_i2c";
				pinctrl-names = "default";
				pinctrl-0 = <0x1f>;
				clock-frequency = <0x61a80>;
				phandle = <0xd4>;

				touchscreen@38 {
					compatible = "focaltech,fts";
					status = "disabled";
					reg = <0x38>;
					reset-gpio = <0x1b 0x0a 0x00>;
					irq-gpio = <0x1b 0x04 0x00>;
					x_max = <0x2d0>;
					y_max = <0x500>;
					max-touch-number = <0x0a>;
				};
			};

			i2c1: i2c@1e000 {
				compatible = "amlogic,meson-g12b-i2c";
				status = "disabled";
				reg = <0x00 0x1e000 0x00 0x20>;
				interrupts = <0x00 0xd6 0x01 0x00 0x5c 0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x02 0x2b>;
				clock-names = "clk_i2c";
				phandle = <0xd5>;
			};

			i2c2: i2c@1d000 {
				compatible = "amlogic,meson-g12b-i2c";
				status = "disabled";
				reg = <0x00 0x1d000 0x00 0x20>;
				interrupts = <0x00 0xd7 0x01 0x00 0x5e 0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x02 0x2b>;
				clock-names = "clk_i2c";
				pinctrl-names = "default";
				pinctrl-0 = <0x20>;
				clock-frequency = <0x186a0>;
				phandle = <0xd6>;

				sensor-i2c@6c {
					compatible = "arm, i2c-sensor";
